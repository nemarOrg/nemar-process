{
  "title": "nemar.qc-summary.v1",
  "description": "A JSON Schema (draft 2020-12, every object closed) for the quality-control summary of one dataset, written by nemar-floor as desc-nemarfloor_qcsummary.json: what the floor found over every recording, in one small file (at most 65,536 bytes). It says what the quality control describes (the archived recordings, or NEMAR's Zarr serving copy) and holds no sampling rate: a recording's rate is in that recording's own record, under extensions.nemar.mask_grid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "dataset_id",
    "dataset_version",
    "recipe",
    "recipe_version",
    "input_kind",
    "profile",
    "describes",
    "counts",
    "distributions",
    "not_processed",
    "not_processed_truncated",
    "record_sha256"
  ],
  "properties": {
    "format": {
      "const": "nemar.qc-summary.v1"
    },
    "dataset_id": {
      "type": ["string", "null"],
      "pattern": "^(nm|on|xx)[0-9]{6}(?![\\s\\S])"
    },
    "dataset_version": {
      "type": ["string", "null"],
      "pattern": "^(latest|v[0-9]+\\.[0-9]+\\.[0-9]+)(?![\\s\\S])"
    },
    "recipe": {
      "const": "nemar-floor"
    },
    "recipe_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-b[1-9][0-9]*)?(?![\\s\\S])"
    },
    "input_kind": {
      "enum": ["bids", "zarr"]
    },
    "profile": {
      "enum": ["archive", "serving"]
    },
    "describes": {
      "enum": [
        "QC describes the dataset's recordings as archived.",
        "QC describes NEMAR's Zarr serving copy (EEG capped at 250 Hz, 16-bit), not the archived recordings."
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "succeeded", "failed", "skipped"],
      "properties": {
        "discovered": {"$ref": "#/$defs/count"},
        "succeeded": {"$ref": "#/$defs/count"},
        "failed": {"$ref": "#/$defs/count"},
        "skipped": {"$ref": "#/$defs/count"}
      }
    },
    "distributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percentGoodChannels",
        "percentGoodSamples",
        "lineNoiseBeforeDb",
        "lineNoiseAfterDb"
      ],
      "properties": {
        "percentGoodChannels": {"$ref": "#/$defs/distribution"},
        "percentGoodSamples": {"$ref": "#/$defs/distribution"},
        "lineNoiseBeforeDb": {"$ref": "#/$defs/distribution"},
        "lineNoiseAfterDb": {"$ref": "#/$defs/distribution"}
      }
    },
    "not_processed": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "code"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status": {"enum": ["failed", "skipped"]},
          "code": {"type": "string", "minLength": 1}
        }
      }
    },
    "not_processed_truncated": {
      "$ref": "#/$defs/count"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"input_kind": {"const": "zarr"}}, "required": ["input_kind"]},
      "then": {
        "properties": {
          "profile": {"const": "serving"},
          "describes": {
            "const": "QC describes NEMAR's Zarr serving copy (EEG capped at 250 Hz, 16-bit), not the archived recordings."
          }
        }
      }
    },
    {
      "if": {"properties": {"input_kind": {"const": "bids"}}, "required": ["input_kind"]},
      "then": {
        "properties": {
          "profile": {"const": "archive"},
          "describes": {"const": "QC describes the dataset's recordings as archived."}
        }
      }
    }
  ],
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "min", "median", "max", "histogram"],
      "properties": {
        "n": {"$ref": "#/$defs/count"},
        "min": {"type": ["number", "null"]},
        "median": {"type": ["number", "null"]},
        "max": {"type": ["number", "null"]},
        "histogram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["edges", "counts", "underflow", "overflow"],
          "properties": {
            "edges": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "integer"}
            },
            "counts": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/count"}
            },
            "underflow": {"$ref": "#/$defs/count"},
            "overflow": {"$ref": "#/$defs/count"}
          }
        }
      }
    }
  }
}
