{
  "id": "nemar-exec",
  "description": "NEMAR execution system: SSH to the cluster's login node, Slurm batch, one static community account. Registered by scripts/register.py from this template; every operator value is a placeholder (docs/operator.md). There is no credential and no storage system here.",
  "systemType": "LINUX",
  "host": "${EXEC_HOST}",
  "effectiveUserId": "${COMMUNITY_ACCOUNT}",
  "defaultAuthnMethod": "${AUTHN_METHOD}",
  "rootDir": "${EXEC_ROOT_DIR}",
  "canExec": true,
  "canRunBatch": true,
  "enableCmdPrefix": false,
  "allowChildren": false,
  "jobRuntimes": [{ "runtimeType": "ZIP" }],
  "jobWorkingDir": "/jobs",
  "batchScheduler": "SLURM",
  "batchDefaultLogicalQueue": "shared",
  "batchLogicalQueues": [
    {
      "name": "shared",
      "hpcQueueName": "shared",
      "maxNodeCount": 1,
      "maxCoresPerNode": 128,
      "maxMemoryMB": 249208,
      "maxMinutes": 2880,
      "maxJobsPerUser": 4096,
      "schedulerOptions": [
        { "name": "account", "arg": "--account=${SLURM_ACCOUNT_CPU}", "inputMode": "FIXED" }
      ]
    },
    {
      "name": "compute",
      "hpcQueueName": "compute",
