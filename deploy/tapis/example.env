# Example operator values for the Tapis definitions, for CI and as a template to copy.
# Every value here is a stand-in: nothing in this repository names a real host, account or path.
# Copy this file somewhere outside the repository, fill in the real values, and pass it to
#   scripts/register.py --vars FILE ...
# Values are raw (no quoting) and may not hold a newline. docs/operator.md says what each one is.

# The execution system: where Tapis connects, and the one account every job runs as.
EXEC_HOST=login.example.org
COMMUNITY_ACCOUNT=community
AUTHN_METHOD=PKI_KEYS

# A directory only that account can read (mode 0700) on the cluster's scratch filesystem, never a
# home directory. Tapis's job directories are created under it.
EXEC_ROOT_DIR=/path/to/exec-root

# Where the runtime images (<64 hex digits>.sif) are installed, NEMAR's copy of the datasets if the
# node has one, and a node-local directory for scratch.
SIF_ROOT=/path/to/sif
LOCAL_DATASETS_ROOT=/path/to/datasets
NODE_LOCAL_TMPDIR=/path/to/node-local-tmp

# The scheduler accounts charged for CPU and for GPU partitions (the same name twice if one account
# holds both).
SLURM_ACCOUNT_CPU=example-cpu
SLURM_ACCOUNT_GPU=example-gpu
