# Operator values for the registration tests: shaped like real ones, naming nothing real, and none
# of them one of the repository's reserved example values (scripts/register.py refuses those under
# --apply). They are read by tests/deploy/test_tapis_register.py against a local stand-in tenant.
EXEC_HOST=login.cluster.invalid
COMMUNITY_ACCOUNT=svc_nemar
AUTHN_METHOD=PKI_KEYS
EXEC_ROOT_DIR=/srv/nemar/exec
SIF_ROOT=/srv/nemar/sif
LOCAL_DATASETS_ROOT=/srv/nemar/datasets
NODE_LOCAL_TMPDIR=/srv/nemar/tmp
SLURM_ACCOUNT_CPU=acct-cpu
SLURM_ACCOUNT_GPU=acct-gpu
